{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost,1433;Database=WebhookDelivery;User Id=sa;Password=your_password_here;TrustServerCertificate=True;"
  },
  "Database": {
    "ApplyMigrationsOnStartup": true
  },
  "Delivery": {
    "BatchSize": 50,
    "DisableEndpointAfterConsecutiveFailures": 20,
    "Sender": {
      "Timeout": "00:00:10",
      "MaxResponseBodyCharacters": 2000,
      "UserAgent": "WebhookDelivery/1.0"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*"
}

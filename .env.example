# SQL Server
# At least 8 characters with three of: uppercase, lowercase, digits, symbols.
MSSQL_SA_PASSWORD=your_password_here
SQLSERVER_PORT=1433
DATABASE_NAME=WebhookDelivery

# API
API_PORT=8080
ASPNETCORE_ENVIRONMENT=Development

# Delivery behaviour
DELIVERY_BATCH_SIZE=50
DISABLE_ENDPOINT_AFTER_FAILURES=20

# Receiver used by the demo script to show deliveries arriving
RECEIVER_PORT=9090
